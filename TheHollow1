-- ───────────────────────── config ─────────────────────────
local CFG = {
  speed = 32,
  roundDelay = 30,        -- seconds between journey rounds
  cutsceneTimeout = 25,   -- how long to let the game's own portal cutscene run before firing the reward remote
  waypointGap = 60,       -- merge sweep waypoints closer than this (studs)
  skipPaths = { "FinaleZone" }, -- sweep never goes under these paths (finale stays manual)
}

local ELEMENT = { "Connection", "Light", "Darkness", "Fire", "Earth", "Water", "Energy", "Time", "Ice", "Air" }

-- NPCTrades from the dump: 1-10 = 5 common -> primal of that category, 11 = any primal
local TRADES = {}
for i = 1, 10 do TRADES[i] = { offer = 5, reward = i, limit = 1 } end
TRADES[11] = { offer = 5, reward = -1, limit = 1 }

-- ───────────────────────── state ─────────────────────────
local alive = true
local conns = {}
local function track(c) conns[#conns + 1] = c; return c end

local S = {
  journey = false, collect = false, gifts = false,
  espMobs = false, espDrops = false, espPortals = false,
  bright = false, speed = false, noclip = false, infjump = false, spy = false,
  antiafk = true,
}

-- cancel token: bumping gen aborts whatever pass is running
local gen = 0
local function stale(g) return (not alive) or g ~= gen end

local status, prog -- TextLabels, set by the UI below
local function notify(msg)
  if status then status.Text = msg end
end

-- only one automation pass touches the character at a time
local busy = false
local function locked(fn)
  if busy then return false end
  busy = true
  local ok, err = pcall(fn)
  busy = false
  if not ok then
    warn("[JK] " .. tostring(err))
    notify("error: " .. tostring(err))
  end
  return true
end

-- ───────────────────────── helpers ─────────────────────────
local function root()
  local c = lp.Character
  return c and c:FindFirstChild("HumanoidRootPart")
end

local function humanoid()
  local c = lp.Character
  return c and c:FindFirstChildOfClass("Humanoid")
end

local function posOf(i)
  if i:IsA("BasePart") then return i.Position end
  if i:IsA("Attachment") then return i.WorldPosition end
  if i:IsA("Model") then return i:GetPivot().Position end
  return nil
end

local function anchorOf(i)
  if i:IsA("BasePart") or i:IsA("Attachment") then return i end
  if i:IsA("Model") then return i.PrimaryPart or i:FindFirstChildWhichIsA("BasePart", true) end
  return nil
end

local function tpTo(pos)
  local r = root()
  if not r then return false end
  r.CFrame = CFrame.new(pos)
  r.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
  return true
end

local function pickRemote(part)
  local r = part:FindFirstChild("PickUp")
  if r and string.find(r.ClassName, "RemoteEvent") then return r end
  return nil
end

-- Remotes live somewhere under ReplicatedStorage (RemoteUtils looks them up by name)
local remoteCache = {}
local function remote(name)
  local r = remoteCache[name]
  if r and r.Parent then return r end
  local folder = ReplicatedStorage:FindFirstChild("Remotes")
  r = (folder and folder:FindFirstChild(name, true)) or ReplicatedStorage:FindFirstChild(name, true)
  if r then remoteCache[name] = r end
  return r
end

local function firePrompt(pp)
  pp.Enabled = true
  if fireproximityprompt then
    fireproximityprompt(pp)
  elseif getconnections then
    for _, c in ipairs(getconnections(pp.Triggered)) do pcall(function() c:Fire() end) end
  end
end

local function dist(a, b) return (a - b).Magnitude end

-- greedy nearest-neighbour ordering so we do not zig-zag across the map
local function nearestOrder(items, from, posf)
  local out, cur = {}, from
  local pool = {}
  for i, v in ipairs(items) do pool[i] = v end
  while #pool > 0 do
    local bi, bd = 1, math.huge
    for i, v in ipairs(pool) do
      local d = dist(posf(v), cur)
      if d < bd then bi, bd = i, d end
    end
    local v = table.remove(pool, bi)
    out[#out + 1] = v
    cur = posf(v)
  end
  return out
end

-- ───────────────────────── game data ─────────────────────────
-- Player attribute "Inventory" is JSON: [category][eggIndex] = amount
local function readInventory()
  local inv = {}
  local raw = lp:GetAttribute("Inventory")
  if type(raw) ~= "string" then return inv end
  local ok, data = pcall(function() return HttpService:JSONDecode(raw) end)
  if not ok or type(data) ~= "table" then return inv end
  for c, row in pairs(data) do
    local cn = tonumber(c)
    if cn and type(row) == "table" then
      inv[cn] = {}
      for i, n in pairs(row) do
        local idx = tonumber(i)
        if idx then inv[cn][idx] = tonumber(n) or 0 end
      end
    end
  end
  return inv
end

local function zoneDone(cat)
  if lp:GetAttribute("PlayedEggIntoPortal" .. cat) then return true end
  local b = lp:FindFirstChild("Badges")
  if b and b:GetAttribute("Category" .. cat .. "Discovered") then return true end
  return false
end

local function progressText()
  local inv = readInventory()
  local own, spare = 0, 0
  for c = 1, 10 do
    for i = 1, 10 do
      local n = (inv[c] and inv[c][i]) or 0
      if n > 0 then own = own + 1 end
      if i <= 5 and n > 1 then spare = spare + (n - 1) end
    end
  end
  local zones, trades = 0, 0
  for c = 1, 10 do
    if zoneDone(c) then zones = zones + 1 end
  end
  for t = 1, 11 do
    if (lp:GetAttribute("qf_NPCTrade" .. t) or 0) >= 1 then trades = trades + 1 end
  end
  return ("eggs %d/100 | spare commons %d\nzones %d/10 | trades %d/11 | day %s"):format(
    own, spare, zones, trades, tostring(workspace:GetAttribute("EventDay") or "?"))
end

-- Egg drops carry attribute EggDrop; UGC drops carry ItemId + BadgeName. Both have a PickUp remote
-- and flip the "Claimed" attribute once taken.
local function findDrops()
  local out, seen = {}, {}
  local function add(p)
    if p:IsA("BasePart") and not seen[p] and not p:GetAttribute("Claimed") and pickRemote(p) then
      seen[p] = true
      out[#out + 1] = p
    end
  end
  for _, tag in ipairs({ "%EggDrop", "%UGCDrop" }) do -- (inferred tag names)
    for _, p in ipairs(CollectionService:GetTagged(tag)) do add(p) end
  end
  for _, d in ipairs(workspace:GetDescendants()) do
    if d:IsA("BasePart")
      and (d:GetAttribute("EggDrop") ~= nil or (d:GetAttribute("ItemId") ~= nil and d:GetAttribute("BadgeName") ~= nil)) then
      add(d)
    end
  end
  return out
end

-- EggIntoPortal parts: CategoryIndex attribute + CamLook child, no PickUp (that would be an egg drop)
local function findPortals()
  local out = {}
  for _, d in ipairs(workspace:GetDescendants()) do
    if d:IsA("BasePart") and d:GetAttribute("CategoryIndex") ~= nil
      and d:FindFirstChild("CamLook") and not pickRemote(d) then
      out[#out + 1] = d
    end
  end
  return out
end

local function findTradeNPCs()
  local out = {}
  for _, d in ipairs(workspace:GetDescendants()) do
    if d:IsA("BasePart") and d:GetAttribute("TradeListIndex") ~= nil then out[#out + 1] = d end
  end
  return out
end

local function findGifts()
  local out = {}
  for _, d in ipairs(workspace:GetDescendants()) do
    if d:IsA("BasePart") and d:GetAttribute("MaxTokens") ~= nil
      and d:FindFirstChild("InsertToken") and d:FindFirstChildOfClass("ProximityPrompt") then
      out[#out + 1] = d
    end
  end
  return out
end

-- ───────────────────────── step: collect ─────────────────────────
local function grab(p, g)
  if not tpTo(p.Position + Vector3.new(0, 2, 0)) then return end -- inside the 5-stud prompt range
  local t0 = os.clock()
  while not stale(g) and p.Parent and not p:GetAttribute("Claimed") and os.clock() - t0 < 0.8 do
    task.wait(0.05)
  end
  if not stale(g) and p.Parent and not p:GetAttribute("Claimed") then
    local rem = pickRemote(p)
    if rem then rem:FireServer() end -- same call as the game's PromptShown handler
    task.wait(0.25)
  end
end

-- one pass over every drop currently streamed in; returns how many it visited
local function collectNow(g)
  local r = root()
  if not r then return 0 end
  local list = findDrops()
  if #list == 0 then return 0 end
  local home = r.CFrame
  local n = 0
  for _, p in ipairs(nearestOrder(list, r.Position, function(x) return x.Position end)) do
    if stale(g) then break end
    grab(p, g)
    n = n + 1
  end
  local rr = root()
  if rr then rr.CFrame = home end
  return n
end

-- ───────────────────────── step: sweep ─────────────────────────
local function skipped(inst)
  local name = inst:GetFullName()
  for _, bad in ipairs(CFG.skipPaths) do
    if string.find(name, bad, 1, true) then return true end
  end
  return false
end

local function waypoints()
  local pts = {}
  local function add(inst)
    local p = posOf(inst)
    if p and not skipped(inst) then pts[#pts + 1] = p end
  end
  for _, i in ipairs(CollectionService:GetTagged("TeleTargetAttachment")) do add(i) end
  for _, part in ipairs(findPortals()) do add(part) end
  return pts
end

local function dedupe(pts, gap)
  local out = {}
  for _, p in ipairs(pts) do
    local keep = true
    for _, q in ipairs(out) do
      if dist(p, q) < gap then
        keep = false
        break
      end
    end
    if keep then out[#out + 1] = p end
  end
  return out
end

local function sweep(g)
  local r = root()
  if not r then return end
  local home = r.CFrame
  local total = collectNow(g)
  local pts = nearestOrder(dedupe(waypoints(), CFG.waypointGap), r.Position, function(p) return p end)
  for i, p in ipairs(pts) do
    if stale(g) then break end
    if not tpTo(p + Vector3.new(0, 5, 0)) then break end
    notify(("sweep %d/%d (%d drops so far)"):format(i, #pts, total))
    pcall(function() lp:RequestStreamAroundAsync(p, 1.5) end) -- no-op when streaming is off
    task.wait(0.4)
    total = total + collectNow(g)
  end
  local rr = root()
  if rr then rr.CFrame = home end
end

-- ───────────────────────── step: discover zones ─────────────────────────
local zoneCool = {}

local function discoverAll(g)
  for _, part in ipairs(findPortals()) do
    if stale(g) then return end
    local cat = part:GetAttribute("CategoryIndex")
    if cat and not zoneDone(cat) and (zoneCool[part] or 0) < os.clock() then
      notify(("zone %d (%s): entering"):format(cat, ELEMENT[cat] or "?"))
      tpTo(part.Position + Vector3.new(0, part.Size.Y / 2 + 4, 0))
      local t0 = os.clock()
      while not stale(g) and not zoneDone(cat) and os.clock() - t0 < CFG.cutsceneTimeout do
        task.wait(0.5)
      end
      if not stale(g) and not zoneDone(cat) then
        local rem = remote("DiscoveredZoneReward")
        if rem then rem:FireServer(part) end -- same call the cutscene ends with
        zoneCool[part] = os.clock() + 120
        task.wait(1.5)
      end
    end
  end
end

-- ───────────────────────── step: NPC trades ─────────────────────────
local tradeCool = {}

-- spare commons only: the GUI offers amount-1 per egg and rarity 1 = eggs 1-5
local function buildOffer(inv, need)
  local offer, got = {}, 0
  for cat = 1, 10 do
    for idx = 1, 5 do
      local spare = ((inv[cat] and inv[cat][idx]) or 0) - 1
      if spare > 0 and got < need then
        local take = math.min(spare, need - got)
        local ck = tostring(cat)
        offer[ck] = offer[ck] or {}
        offer[ck][tostring(idx)] = take
        got = got + take
      end
    end
  end
  if got == need then return offer end
  return nil
end

-- primal eggs are indices 6-9; pick the one we own the fewest of
local function pickReward(inv, reward)
  local lo, hi = reward, reward
  if reward == -1 then lo, hi = 1, 10 end
  local best, bestN
  for cat = lo, hi do
    for idx = 6, 9 do
      local n = (inv[cat] and inv[cat][idx]) or 0
      if best == nil or n < bestN then
        best, bestN = { cat, idx }, n
      end
    end
  end
  return best
end

local function tradeAll(g)
  local ev = remote("NPCTrade")
  if not ev then
    notify("NPCTrade remote not found")
    return 0
  end
  local did = 0
  for _, npc in ipairs(findTradeNPCs()) do
    if stale(g) then break end
    local id = npc:GetAttribute("TradeListIndex")
    local trade = TRADES[id]
    local key = "qf_NPCTrade" .. tostring(id)
    local before = lp:GetAttribute(key) or 0
    if trade and before < trade.limit and (tradeCool[npc] or 0) < os.clock() then
      local inv = readInventory()
      local offer = buildOffer(inv, trade.offer)
      local pick = pickReward(inv, trade.reward)
      if offer and pick then
        notify(("trade %d: egg %d-%d"):format(id, pick[1], pick[2]))
        tpTo(npc.Position + Vector3.new(0, 3, 5)) -- NPC ring is 10 studs
        task.wait(0.6)
        ev:FireServer(id, offer, { pick[1], pick[2] }) -- (tradeId, offer, chosen reward) like the GUI
        local t0 = os.clock()
        while not stale(g) and (lp:GetAttribute(key) or 0) == before and os.clock() - t0 < 4 do
          task.wait(0.2)
        end
        if (lp:GetAttribute(key) or 0) == before then tradeCool[npc] = os.clock() + 60 end
        did = did + 1
      end
    end
  end
  return did
end

-- ───────────────────────── step: gifts ─────────────────────────
local function isElite(part)
  local s = string.lower(part.Name)
  for _, t in ipairs(CollectionService:GetTags(part)) do s = s .. " " .. string.lower(t) end
  local par = part.Parent
  while par and par ~= workspace do
    s = s .. " " .. string.lower(par.Name)
    par = par.Parent
  end
  return string.find(s, "elite") ~= nil
end

local giftCooldown, giftHome = {}, nil

-- returns true if it acted (so callers re-evaluate after every token)
local function giftPass(g)
  for _, part in ipairs(findGifts()) do
    local elite = isElite(part)
    local spentK = elite and "SpentEliteTokens" or "SpentTokens"
    local earnedK = elite and "EarnedEliteTokens" or "EarnedTokens"
    local spent, earned, max = lp:GetAttribute(spentK), lp:GetAttribute(earnedK), part:GetAttribute("MaxTokens")
    if spent and earned and max and spent < earned and spent < max and (giftCooldown[part] or 0) < os.clock() then
      local r = root()
      if not r then return false end
      if not giftHome then giftHome = r.CFrame end
      tpTo(part.Position + Vector3.new(0, 3, 10)) -- prompt range is 28
      task.wait(0.4)
      firePrompt(part:FindFirstChildOfClass("ProximityPrompt"))
      notify(("inserting token (%d/%d)"):format(spent, earned))
      local t0 = os.clock()
      while not stale(g) and lp:GetAttribute(spentK) == spent and os.clock() - t0 < 10 do
        task.wait(0.2)
      end
      if lp:GetAttribute(spentK) == spent then giftCooldown[part] = os.clock() + 60 end
      return true
    end
  end
  return false
end

local function giftAll(g)
  for _ = 1, 40 do
    if stale(g) or not giftPass(g) then break end
  end
end

local function giftReturn()
  if giftHome then
    local r = root()
    if r then r.CFrame = giftHome end
    giftHome = nil
  end
end

-- ───────────────────────── journey ─────────────────────────
local function journeyRound(g)
  local r = root()
  if not r then return end
  local home = r.CFrame
  notify("1/4 sweep + collect")
  sweep(g)
  if stale(g) then return end
  notify("2/4 discover zones")
  discoverAll(g)
  if stale(g) then return end
  notify("3/4 NPC trades")
  tradeAll(g)
  if stale(g) then return end
  notify("4/4 gift tokens")
  giftAll(g)
  giftReturn()
  local rr = root()
  if rr then rr.CFrame = home end
  notify("round done, next in " .. CFG.roundDelay .. "s")
end

task.spawn(function()
  while alive do
    if S.journey then
      local g = gen
      locked(function() journeyRound(g) end)
      for _ = 1, CFG.roundDelay do
        if stale(g) or not S.journey then break end
        task.wait(1)
      end
    else
      task.wait(1)
    end
  end
end)

-- standalone loops (only when the journey is off)
task.spawn(function()
  while alive do
    if S.collect and not S.journey and root() then
      local g = gen
      locked(function()
        local n = collectNow(g)
        if n > 0 then notify("collected " .. n .. " drop(s)") end
      end)
    end
    task.wait(2)
  end
end)

task.spawn(function()
  while alive do
    if S.gifts and not S.journey and root() then
      local g = gen
      locked(function()
        if not giftAll(g) and not giftHome then return end
        giftReturn()
      end)
    end
    task.wait(1)
  end
end)

-- progress readout
task.spawn(function()
  while alive do
    if prog then
      local ok, txt = pcall(progressText)
      if ok then prog.Text = txt end
    end
    task.wait(2)
  end
end)

